# ── Runtime ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# "demo" (default, deterministic synthetic Ethereum data) or "real"
DATA_MODE=demo

# ── Persistence ────────────────────────────────────────────────────────────
# When set, investigations and alert reviews are stored in PostgreSQL.
# Without it, ChainScope uses an atomic JSON file store at data/runtime/store.json.
# DATABASE_URL=postgresql://chainscope:chainscope@localhost:5432/chainscope

# ── Real data provider (server-side only) ──────────────────────────────────
# Required only when DATA_MODE=real. Get a key at https://etherscan.io/apis
# ETHERSCAN_API_KEY=
# Chain ID used for Etherscan API v2 lookups (1 = Ethereum mainnet)
ETHERSCAN_CHAIN_ID=1
# Directory used to persist imported address histories (real mode)
PROVIDER_CACHE_DIR=data/provider-cache
# Max pages of 100 transactions fetched per transfer category/address
PROVIDER_MAX_PAGES=3
